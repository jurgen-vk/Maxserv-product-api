{% set items = items|default([]) %}

<div {{ attrs(defaults: { class: 'c_ui_media-carousel' }, attributes: attributes) }}>
  <div class="main">
    {% if items|length > 1 %}
      <button type="button" class="arrow prev">
        {{ icon('lucide:chevron-left') }}
      </button>
    {% endif %}

    {% if items|length > 0 %}
      <img src="{{ items[0].url }}" alt="{{ items[0].alt|default('') }}">
    {% else %}
      <div class="placeholder">{{ icon('lucide:image') }}</div>
    {% endif %}

    {% if items|length > 1 %}
      <button type="button" class="arrow next">
        {{ icon('lucide:chevron-right') }}
      </button>
    {% endif %}
  </div>

  {% if items|length > 1 %}
    <div class="thumbs-row">
      <button type="button" data-carousel-scroll="prev">
        {{ icon('lucide:chevron-left') }}
      </button>
      <div class="thumbs">
        {% for item in items %}
          <button type="button" class="thumb"{{ loop.first ? ' data-active' : '' }} data-index="{{ loop.index0 }}">
            <img src="{{ item.url }}" alt="{{ item.alt|default('') }}">
          </button>
        {% endfor %}
      </div>
      <button type="button" data-carousel-scroll="next">
        {{ icon('lucide:chevron-right') }}
      </button>
    </div>
  {% endif %}
</div>
