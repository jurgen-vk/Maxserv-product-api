{% types {
  title: 'string',
  icon?: 'string|null',
  attributes?: 'array|null',
} %}
{% set icon = icon|default(null) %}
{% set attributes = attributes|default(null) %}

<div {{ attrs(defaults: { class: 'c_ui_page-header' }, attributes: attributes) }}>
  <div class="title">
    {% if icon %}{{ icon|raw }}{% endif %}
    <h1>{{ title }}</h1>
  </div>
  <div class="actions">
    {% block actions %}{% endblock %}
  </div>
</div>
<hr>
