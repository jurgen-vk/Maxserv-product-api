{% types {
  type?: 'string',
  href?: 'string|null',
  variant?: 'string|null',
  disabled?: 'bool',
  attributes?: 'array|null',
  label?: 'string',
  iconBefore?: 'string',
  iconAfter?: 'string',
} %}

{% set type = type|default('button') %}
{% set href = href|default(null) %}
{% set variant = variant|default(null) %}
{% set disabled = disabled|default(false) %}
{% set attributes = attributes|default(null) %}
{% set tag = href ? 'a' : 'button' %}
{% set label = label|default('') %}
{% set iconBefore = iconBefore|default('') %}
{% set iconAfter = iconAfter|default('') %}

{% set iconBeforeContent %}{% block iconBefore %}{{ iconBefore|raw }}{% endblock %}{% endset %}
{% set labelContent %}{% block label %}{{ label }}{% endblock %}{% endset %}
{% set iconAfterContent %}{% block iconAfter %}{{ iconAfter|raw }}{% endblock %}{% endset %}

<{{ tag }} {{ attrs(
  defaults: {
    class: 'c_ui_button',
    'data-variant': variant,
    type: tag == 'a' ? null : type,
    href: href,
    disabled: (tag == 'button' and disabled) ? true : null,
  },
  attributes: attributes
) }}>
{% if iconBeforeContent|trim is not empty %}
  <span class="icon-container icon--before">{{ iconBeforeContent }}</span>
{% endif %}

{% if labelContent|trim is not empty %}
  <span class="label">{{ labelContent }}</span>
{% endif %}

{% if iconAfterContent|trim is not empty %}
  <span class="icon-container icon--after">{{ iconAfterContent }}</span>
{% endif %}
</{{ tag }}>
