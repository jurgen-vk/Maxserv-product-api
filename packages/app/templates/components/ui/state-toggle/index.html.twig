{% types {
  state?: 'string',
  attributes?: 'array|null',
} %}
{# No known callers found anywhere in the templates tree at time of writing - possibly unused. #}
{% set attributes = attributes|default(null) %}

<div {{ attrs(defaults: { class: 'c_ui_state-toggle' }, attributes: attributes) }} data-state="{{ state|default('idle') }}">
  <div data-state-pane="idle">{% block idle %}{% endblock %}</div>
  <div data-state-pane="loading">{% block loading %}{% endblock %}</div>
</div>
