{% set themeMode = app.request.cookies.get('themeMode') %}

<div class="c_ui_theme-mode-toggle">
  {% embed 'components.ui.toggle' with {
    checked: themeMode == 'dark'
  } only %}
    {% block left %} {{ icon(name: 'lucide:sun') }} {% endblock %}
    {% block right %} {{ icon(name: 'lucide:moon') }} {% endblock %}
  {% endembed %}
</div>
