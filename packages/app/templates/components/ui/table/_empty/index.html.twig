{% set iconName = iconName|default('lucide:inbox') %}
{% set title = title|default('Nothing here yet.') %}
{% set description = description|default('') %}
{% set actionLabel = actionLabel|default(null) %}
{% set actionHref = actionHref|default(null) %}
{% set actionAttributes = actionAttributes|default({}) %}

<div {{ attrs(defaults: { class: 'table-empty' }, attributes: attributes) }}>
  {{ icon(iconName) }}
  <h3>{{ title }}</h3>
  {% if description %}
    <p>{{ description }}</p>
  {% endif %}
  {% if actionLabel and (actionHref or actionAttributes) %}
    {% embed 'components.ui.button' with {
      variant: 'neutral',
      href: actionHref,
      attributes: actionAttributes|merge({ class: ('action ' ~ (actionAttributes.class|default('')))|trim }),
    } only %}
      {% block label %}{{ actionLabel }}{% endblock %}
    {% endembed %}
  {% endif %}
</div>
