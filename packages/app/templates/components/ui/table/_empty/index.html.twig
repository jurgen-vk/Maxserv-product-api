{% set descriptionContent %}{% block description %}{% endblock %}{% endset %}

<div {{ attrs(defaults: { class: 'c_ui_table__empty', 'data-variant': variant }, attributes: attributes) }}>
  <div class="content">
    {% block icon %}{{ icon('lucide:inbox') }}{% endblock %}
    <h3>{% block title %}Nothing here yet.{% endblock %}</h3>
    {% if descriptionContent|trim is not empty %}<p>{{ descriptionContent|raw }}</p>{% endif %}
    {% block action %}{% endblock %}
  </div>
</div>
