{% set bodyContent %}{% block body %}{% endblock %}{% endset %}
{% set emptyContent %}
  {% block empty %}
    {% embed 'components.ui.table._empty' only %}{% endembed %}
  {% endblock %}
{% endset %}

<div {{ attrs(defaults: { class: 'c_ui_table', 'data-variant': variant, 'data-page-param': pageParam }, attributes: attributes) }}>
  <table>
    {% block colgroup %}{% endblock %}
    <thead>{% block head %}{% endblock %}</thead>
    <tbody>
    {% if bodyContent|trim is not empty %}
      {{ bodyContent|raw }}
    {% elseif emptyContent|trim is not empty %}
      <tr class="empty-row">
        <td colspan="100">{{ emptyContent|raw }}</td>
      </tr>
    {% endif %}
    </tbody>
  </table>
</div>
