{% set isEmpty = isEmpty|default(false) %}
{% set varient = variant|default('primary') %}
{% set emptyIcon = emptyIcon|default(icon('lucide:inbox')) %}
{% set emptyTitle = emptyTitle|default('Nothing here yet.') %}
{% set emptyDescription = emptyDescription|default('') %}
{% set emptyActionLabel = emptyActionLabel|default(null) %}
{% set emptyActionHref = emptyActionHref|default(null) %}
{% set emptyActionAttributes = emptyActionAttributes|default({}) %}

<div {{ attrs(defaults: { class: 'c_ui_table' }, attributes: attributes) }}>
  {% if isEmpty %}
    {% block empty %}
      {% include 'components.ui.table._empty' with {
        icon: emptyIcon,
        title: emptyTitle,
        description: emptyDescription,
        actionLabel: emptyActionLabel,
        actionHref: emptyActionHref,
        actionAttributes: emptyActionAttributes,
      } only %}
    {% endblock %}
  {% else %}
    <div class="table-container">
      <table>
        {% block colgroup %}{% endblock %}
        <thead>
        {% block head %}{% endblock %}
        {% if progressBar is defined and progressBar %}
          <tr class="progress-row">
            <td colspan="100">{{ progressBar }}</td>
          </tr>
        {% endif %}
        </thead>
        <tbody>
        {% block body %}{% endblock %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if paginator is defined and paginator %}
    {% include 'components.ui.table._pagination' with {
      paginator: paginator,
      routeName: routeName,
      extraParams: extraParams|default({}),
    } only %}
  {% endif %}
</div>
