{% set placeholder = placeholder|default('Search…') %}
{% set value = value|default('') %}
{% set name = name|default('search') %}
{% set variant = variant|default('primary') %}

<div {{ attrs(defaults: {
  class: 'c_ui_table__search',
  'data-variant': variant
}, attributes: attributes) }}>
  <label class="field">
    {{ icon('lucide:search') }}
    <input
      type="search"
      class="search-input"
      name="{{ name }}"
      value="{{ value }}"
      placeholder="{{ placeholder }}"
    >
    <button type="button" class="clear" {{ value ? '' : 'hidden' }}>
      {{ icon('lucide:x') }}
    </button>
  </label>
  {% embed 'components.ui.button' with {
    variant: 'neutral',
    attributes: { class: 'search-button' },
  } only %}
    {% block label %}Search{% endblock %}
  {% endembed %}
</div>
