{% types {
  id: 'string',
  pageParam?: 'string',
  variant?: 'string|null',
  attributes?: 'array|null',
} %}

{% set attributes = attributes|default(null) %}
{% set variant = variant|default(null) %}
{% set pageParam = pageParam|default('page') %}

<form {{ attrs(
  defaults: { class: 'c_ui_filter-panel', popover: true, id: id, 'data-page-param': pageParam },
  attributes: attributes
) }}>
  {% block fields %}{% endblock %}

  <hr>

  <div class="actions">
    {% embed 'components.ui.filter-panel.clear-button' with { filterPanel: id } only %}
      {% block label %}Clear filters{% endblock %}
    {% endembed %}

    {% embed 'components.ui.button' with { variant: variant, attributes: { type: 'submit' } } only %}
      {% block label %}Apply{% endblock %}
    {% endembed %}
  </div>
</form>
