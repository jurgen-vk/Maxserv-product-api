{% set label = label|default('') %}
{% set placeholder = placeholder|default('') %}
{% set value = value|default('') %}
{% set options = options|default([]) %}
{% set name = name|default('') %}
{% set variant = variant|default('primary') %}
{% set searchable = searchable|default(false) %}
{% set multiselect = multiselect|default(false) %}
{% set animateDropdown = animateDropdown|default({}) %}

{% set customOptions %}{% block options %}{% endblock %}{% endset %}

<div {{ attrs(defaults: { class: 'c_ui_input_select' }, attributes: attributes) }}>
  {% if label %}<label>{{ label }}</label>{% endif %}
  <select
    name="{{ name }}{{ multiselect ? '[]' : '' }}"
    class="select-input"
    data-variant="{{ variant }}"
    data-searchable="{{ searchable ? '1' : '0' }}"
    {% if animateDropdown is not empty %}data-animate-dropdown="{{ animateDropdown|json_encode }}"{% endif %}
    {% if multiselect %}multiple{% endif %}
    {% if placeholder %}data-placeholder="{{ placeholder }}"{% endif %}
  >
    {% if placeholder and not multiselect %}<option value=""></option>{% endif %}
    {% for option in options %}
      <option value="{{ option.value }}"{{ (multiselect and value is iterable and option.value in value) or (not multiselect and option.value == value) ? ' selected' : '' }}>{{ option.label }}</option>
    {% endfor %}
    {% if customOptions|trim is not empty %}{{ customOptions }}{% endif %}
  </select>
</div>
