{% set options = options|default([]) %}
{% set multiselect = multiselect|default(false) %}
{% set settings = settings|default({}) %}

{% set customOptions %}{% block options %}{% endblock %}{% endset %}

<div {{ attrs(
  defaults: {
    class: 'c_ui_input_select input',
    'data-variant': variant,
  },
  attributes: attributes
) }}>
  {% if label %}<label class="label">{{ label }}</label>{% endif %}
  <select
    name="{{ name }}{{ multiselect ? '[]' : '' }}"
    class="select-input input"
    {% if multiselect %}multiple{% endif %}
    {% if placeholder %}data-placeholder="{{ placeholder }}"{% endif %}
    {% if settings is not empty %}data-settings="{{ settings|json_encode }}"{% endif %}
  >
    {% if placeholder and not multiselect %}
      <option value="" class="empty">-</option>{% endif %}
    {% for option in options %}
      <option
        value="{{ option.value }}"{{ (multiselect and value is iterable and option.value in value) or (not multiselect and option.value == value) ? ' selected' : '' }}>{{ option.label }}</option>
    {% endfor %}
    {% if customOptions|trim is not empty %}{{ customOptions }}{% endif %}
  </select>
</div>
