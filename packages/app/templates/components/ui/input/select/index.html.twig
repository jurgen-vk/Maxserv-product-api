{% set label = label|default('') %}
{% set placeholder = placeholder|default('All') %}
{% set value = value|default('') %}
{% set options = options|default([]) %}
{% set name = name|default('') %}
{% set selectedOption = value ? options|filter(o => o.value == value)|first : null %}

<div {{ attrs(defaults: { class: 'c_ui_input_select' }, attributes: attributes) }}>
  {% if label %}<span class="label">{{ label }}</span>{% endif %}
  <div class="control">
    <button type="button" class="trigger" popovertarget="select-panel-{{ name }}">
      <span class="value">{{ selectedOption ? selectedOption.label : placeholder }}</span>
      {{ icon('lucide:chevron-down') }}
    </button>
    <div class="panel" popover id="select-panel-{{ name }}">
      <input type="text" class="select-search" placeholder="Search…">
      <ul class="options">
        <li data-value=""{{ value == '' ? ' data-selected' : '' }}>{{ placeholder }}</li>
        {% for option in options %}
          <li data-value="{{ option.value }}"{{ value == option.value ? ' data-selected' : '' }}>{{ option.label }}</li>
        {% endfor %}
      </ul>
    </div>
    <input type="hidden" name="{{ name }}" value="{{ value }}" class="select-input">
  </div>
</div>
