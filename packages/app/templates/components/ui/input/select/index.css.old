@layer main {
  .c_ui_input_select {
    .ts-wrapper {
      width: 100%;

      &.dropdown-active .ts-control {
        /*border-color: var(--input-border-color-active);*/
      }
    }

    .ts-control {
      --ts-pr-caret: 1.5rem;
      --ts-pr-clear-button: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem;
      position: relative;
      min-height: 0;
      border-radius: var(--radius-default);
      border: 1px solid var(--input-border-color);
      padding: var(--input-padding);
      background-color: var(--input-color);
      font-size: var(--text-md);
      font-weight: var(--text-md-weight);
      letter-spacing: var(--text-md-letter-spacing);
      font-family: var(--font-sans);
      line-height: normal;
      color: var(--input-text-color);

      &::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 0.7rem;
        translate: 0 -50%;
        width: 0.8125rem;
        height: 0.8125rem;
        background-color: var(--color-text-13);
        mask-image: url("~app/icons/lucide/chevron-down.svg");
        mask-size: contain;
        mask-repeat: no-repeat;
        pointer-events: none;
      }

      input {
        border: none;
        margin: 0;
        padding: 0;
        background-color: transparent;
        font: inherit;
        color: var(--input-text-color);

        &::placeholder {
          color: var(--color-text-13);
        }
      }
    }

    .ts-wrapper.multi .ts-control > div {
      margin: 0;
      border-radius: var(--radius-tight);
      padding: 0.0625rem 0.375rem;
      background-color: var(--color-main-5); /* shouldn't be primary */
      color: var(--color-text-1);
    }

    .ts-wrapper.plugin-remove_button .item .remove {
      border: none;
      color: inherit;
    }

    .plugin-clear_button .clear-button {
      right: 0.4rem;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: var(--radius-default);
      font-size: 0; /* hides Tom Select's own "×" text content, the icon below replaces it visually */

      &::after {
        content: "";
        display: block;
        width: 0.8125rem;
        height: 0.8125rem;
        margin: auto;
        background-color: var(--color-text-13);
        mask-image: url("~app/icons/lucide/x.svg");
        mask-size: contain;
        mask-repeat: no-repeat;
      }

      &:hover {
        background-color: var(--color-main-2);

        &::after {
          background-color: var(--color-text-1);
        }
      }
    }

    /*
     * Popper.js (see index.js) handles positioning/flip via JS, computed against .ts-control —
     * it doesn't care whether .ts-dropdown stays a DOM descendant of .ts-wrapper (unlike CSS
     * anchor positioning's position-try-fallbacks, which broke here for reasons that had nothing
     * to do with our own markup — see git history for that investigation), so this stays nested
     * exactly like the rest of the component's CSS, no DOM relocation needed. position/width
     * aren't redeclared here — Tom Select's own base CSS already sets
     * `position: absolute; width: 100%;`, and 100% (relative to .ts-wrapper) already matches
     * .ts-control's width, which is what we want.
     */
    .ts-dropdown {
      display: grid !important;
      overflow: hidden;
      grid-template-rows: 0fr;
      padding: 0 0.5rem;
      transition: grid-template-rows 0.2s ease, padding 0.2s ease;

      .ts-wrapper.dropdown-active & {
        grid-template-rows: 1fr;
        padding: 0.5rem 0.5rem;
        border-radius: 0 0 var(--radius-default) var(--radius-default);
        border: 1px solid var(--input-border-color);
        background-color: var(--input-color);
        box-shadow: var(--shadow-size-xs) var(--shadow-strength-xs);
      }
    }

    .ts-dropdown-content {
      min-height: 0;
      max-height: 13rem;

      .option {
        border-radius: var(--radius-default);
        padding: 0.375rem 0.5rem;
        font-size: var(--text-sm);
        color: var(--input-text-color);
      }
    }
  }

  /*---[ ▼ Variants ▼ ]-----*/
  .c_ui_input_select .ts-wrapper[data-variant="primary"] {
    --input-border-color-active: var(--color-primary-add-1);

    .ts-dropdown-content .active {
      background-color: var(--color-primary-sub-7);
    }

    .ts-dropdown-content .option.selected {
      font-weight: var(--text-2xl-weight);
      background-color: var(--color-primary-sub-5);
    }
  }

  .c_ui_input_select .ts-wrapper[data-variant="neutral"] {
    --input-border-color-active: var(--color-main-3);

    .ts-dropdown-content .active {
      background-color: color-mix(in oklab, var(--color-main-13) 10%, transparent);
    }

    .ts-dropdown-content .option.selected {
      font-weight: var(--text-2xl-weight);
      background-color: color-mix(in oklab, var(--color-main-13) 16%, transparent);
    }
  }
}
