{% set min = min|default(0) %}
{% set max = max|default(100) %}
{% set step = step|default(1) %}
{% set valueMin = valueMin|default(min) %}
{% set valueMax = valueMax|default(max) %}
{% set label = label|default('') %}
{% set nameMin = nameMin|default('min') %}
{% set nameMax = nameMax|default('max') %}
{% set variant = variant|default('primary') %}

<div {{ attrs(defaults: {
  class: 'c_ui_input_range-slider',
  'data-variant': variant
}, attributes: attributes) }}>
  {% if label %}<label class="label">{{ label }}</label>{% endif %}

  <div class="values">
    {% include 'components.ui.input.number' with {
      variant: 'primary',
      value: valueMin,
      min: min,
      max: max,
      step: step,
      attributes: {
        'data-range-number': min
      }
    } only %}
    <span>–</span>
    {% include 'components.ui.input.number' with {
      variant: 'primary',
      value: valueMax,
      min: min,
      max: max,
      step: step,
      attributes: {
        'data-range-number': max
      }
    } only %}
  </div>

  <div class="track">
    <div class="fill"></div>
    <input class="input" type="range" min="{{ min }}" max="{{ max }}" step="{{ step }}" value="{{ valueMin }}"
           data-range-slider="min">
    <input class="input" type="range" min="{{ min }}" max="{{ max }}" step="{{ step }}" value="{{ valueMax }}"
           data-range-slider="max">
  </div>

  <input class="input" type="hidden" name="{{ nameMin }}" value="{{ valueMin }}" data-range-hidden="min">
  <input class="input" type="hidden" name="{{ nameMax }}" value="{{ valueMax }}" data-range-hidden="max">
</div>
