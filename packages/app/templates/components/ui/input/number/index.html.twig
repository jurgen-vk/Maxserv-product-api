{% set id = id|default(null) %}

<label {{ attrs(
  defaults: { class: 'c_ui_input_number', 'data-variant': variant },
  attributes: attributes
) }}>
  {% if label %}<span class="label">{{ label }}</span>{% endif %}

  <input {{ attrs(
    defaults: {
      class: 'input',
      type: 'number',
      id: id,
      name: name,
      value: value,
      min: min,
      max: max,
      step: step,
    }
  ) }}>
</label>
