{% set placeholder = placeholder|default('Search…') %}
{% set name = name|default('search') %}
{% set pageParam = pageParam|default('page') %}

<div {{ attrs(
  defaults: {
    class: 'c_ui_input_search',
    'data-variant': variant,
    'data-page-param': pageParam
  },
  attributes: attributes
) }}>
  <label class="field">
    {{ icon('lucide:search') }}

    <input
      type="search"
      class="input"
      name="{{ name }}"
      value="{{ value }}"
      placeholder="{{ placeholder }}"
    >

    <button type="button" class="clear" {{ value ? '' : 'hidden' }}>
      {{ icon('lucide:x') }}
    </button>
  </label>
  {% embed 'components.ui.button' with { attributes: { class: 'search-button' } } only %}
    {% block label %}Search{% endblock %}
  {% endembed %}
</div>
