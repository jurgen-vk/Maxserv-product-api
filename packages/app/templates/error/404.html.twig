{% types {
  message: 'string',
} %}

{% extends 'layouts.error' %}

{% block title %}Page not found{% endblock %}

{% block content %}
  <div class="error-page">
    <p class="code">404</p>
    <h1 class="title">Page not found</h1>
    <p class="message">{{ message }}</p>
    {% embed 'components.ui.button' with { variant: 'primary', href: path(name: 'home_index') } only %}
      {% block label %}Go Home{% endblock %}
    {% endembed %}
  </div>
{% endblock %}