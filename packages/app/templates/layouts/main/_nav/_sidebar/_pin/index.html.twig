{% set sidebarPinned = app.request.cookies.get('sidebarPinned') %}

{% embed 'components.ui.button' with {
  variant: 'bare',
  attributes: { class: 'l_main__nav__sidebar__pin', 'data-pressed': sidebarPinned == 'true' ? true : null },
} only %}
  {% block iconBefore %} {{ icon(name: 'lucide:pin') }} {% endblock %}
  {% block iconAfter %} {{ icon(name: 'lucide:pin-off') }} {% endblock %}
{% endembed %}