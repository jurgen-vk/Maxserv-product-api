{% set currentPath = app.request.pathinfo %}
{% set isActive = href and (currentPath == href or currentPath starts with (href ~ '/')) %}

<a href="{{ href }}" class="l_main__nav__sidebar__link"{{ isActive ? ' data-active' : '' }}>
  <span class="icon-slot">{{ icon|raw }}</span>
  <span class="label">{{ label }}</span>
</a>
