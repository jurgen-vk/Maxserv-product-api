{% set statusVariant = { pending: 'neutral', started: 'info', running: 'info', completed: 'success', failed: 'danger' } %}

<div {{ attrs(defaults: { class: 'p_imports__imports-table' }, attributes: attributes) }}>
  {% embed 'components.ui.table' %}
    {% block head %}
      <tr>
        <th>ID</th>
        <th>Type</th>
        <th>Progress</th>
        <th>Status</th>
        <th>Started</th>
        <th>Completed</th>
        <th>Processed</th>
        <th>Total</th>
      </tr>
    {% endblock %}

    {% block body %}
      {% for import in imports %}
        {% set percent = import.total > 0 ? (import.processed / import.total * 100)|round : 0 %}

        <tr class="import-row" data-import-id="{{ import.id }}" data-status="{{ import.status.value }}"
            data-processed="{{ import.processed }}" data-total="{{ import.total }}">
          <td class="import-td-id">#{{ import.id }}</td>
          <td class="import-td-type">{{ import.type|capitalize }}</td>
          <td class="import-td-progress">
            <div class="progress">
              {% include 'components.ui.progress-bar' with {
                variant: statusVariant[import.status.value],
                attributes: { style: '--progress: ' ~ percent ~ '%' },
              } only %}
              <span class="percent progress-text">{{ percent }}%</span>
            </div>
          </td>
          <td class="import-td-status">
            {% include 'components.ui.badge' with {
              variant: statusVariant[import.status.value],
              label: import.status.value|capitalize
            } only %}
          </td>
          <td class="import-td-started">{{ import.startedAt|date('Y-m-d H:i') }}</td>
          <td class="import-td-completed">{{ import.completedAt ? import.completedAt|date('Y-m-d H:i') : '—' }}</td>
          <td class="import-td-processed">{{ import.processed }}</td>
          <td class="import-td-total">{{ import.total }}</td>
        </tr>
      {% endfor %}
    {% endblock %}

    {% block empty %}
      {% embed 'components.ui.table._empty' %}
        {% block title %}No imports yet{% endblock %}
        {% block description %}Imports you start from different pages will show up here.{% endblock %}
      {% endembed %}
    {% endblock %}
  {% endembed %}

  {% include 'components.ui.paginator' with { paginator: paginator } only %}
</div>