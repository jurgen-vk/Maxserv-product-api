{% set typeOptions = types|map(t => { value: t, label: t|capitalize }) %}
{% set statusOptions = statuses|map(s => { value: s.value, label: s.value|capitalize }) %}

<div {{ attrs(defaults: {
  class: 'p_imports__filter-panel'
}, attributes: attributes) }}>
  {% embed 'components.ui.filter-panel' with {
    variant: 'primary',
    id: 'imports-filter-panel',
    pageParam: pageParam,
    filter: filter,
    typeOptions: typeOptions,
    statusOptions: statusOptions,
  } only %}
    {% block fields %}
      {% include 'components.ui.input.select' with {
        variant: 'primary',
        label: 'Type',
        name: 'type',
        value: filter.type,
        placeholder: 'Types',
        options: typeOptions,
        settings: {
          plugins: {
            clear_button,
          }
        },
      } only %}

      {% include 'components.ui.input.select' with {
        variant: 'primary',
        label: 'Status',
        name: 'statuses',
        value: filter.statuses,
        placeholder: 'Statuses',
        options: statusOptions,
        multiselect: true,
        settings: {
          plugins: {
            remove_button,
            clear_button
          }
        }
      } only %}

      <div class="date-range">
        <label>Started Range</label>
        {% include 'components.ui.input.date' with {
          variant: 'primary',
          name: 'startedFrom',
          value: filter.startedFrom,
        } only %}

        {% include 'components.ui.input.date' with {
          variant: 'primary',
          name: 'startedTo',
          value: filter.startedTo,
        } only %}
      </div>

      <div class="date-range">
        <label>Ended Range</label>
        {% include 'components.ui.input.date' with {
          variant: 'primary',
          name: 'endedFrom',
          value: filter.endedFrom,
        } only %}

        {% include 'components.ui.input.date' with {
          variant: 'primary',
          name: 'endedTo',
          value: filter.endedTo,
        } only %}
      </div>
    {% endblock %}
  {% endembed %}
</div>
