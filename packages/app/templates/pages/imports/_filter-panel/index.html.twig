{% types {
  types: 'array<string>',
  statuses: 'array<MaxServ\\App\\Enum\\ImportStatus>',
  filter: 'MaxServ\\App\\Filter\\ImportFilter',
  pageParam?: 'string',
  variant?: 'string',
  attributes?: 'array',
} %}

{% set attributes = attributes|default(null) %}
{% set typeOptions = types|map(t => { value: t, label: t|capitalize }) %}
{% set statusOptions = statuses|map(s => { value: s.value, label: s.value|capitalize }) %}
{% set variant = variant|default(null) %}
{% set pageParam = pageParam|default('page') %}

<div {{ attrs(defaults: {
  class: 'p_imports__filter-panel'
}, attributes: attributes) }}>
  {% embed 'components.ui.filter-panel' with {
    variant: variant,
    id: 'imports-filter-panel',
    pageParam: pageParam,
    filter: filter,
    typeOptions: typeOptions,
    statusOptions: statusOptions,
  } only %}
    {% block fields %}
      {% include 'components.ui.input.select' with {
        variant: variant,
        label: 'Type',
        name: 'type',
        value: filter.type,
        placeholder: 'Types',
        options: typeOptions,
        settings: {
          plugins: {
            clear_button: {},
          }
        },
      } only %}

      {% include 'components.ui.input.select' with {
        variant: variant,
        label: 'Status',
        name: 'statuses',
        value: filter.statuses,
        placeholder: 'Statuses',
        options: statusOptions,
        multiselect: true,
        settings: {
          plugins: {
            remove_button: {},
            clear_button: {}
          }
        }
      } only %}

      <div class="date-range">
        <label>Started Range</label>
        {% include 'components.ui.input.date' with {
          variant: variant,
          name: 'startedFrom',
          value: filter.startedFrom,
        } only %}

        {% include 'components.ui.input.date' with {
          variant: variant,
          name: 'startedTo',
          value: filter.startedTo,
        } only %}
      </div>

      <div class="date-range">
        <label>Ended Range</label>
        {% include 'components.ui.input.date' with {
          variant: variant,
          name: 'endedFrom',
          value: filter.endedFrom,
        } only %}

        {% include 'components.ui.input.date' with {
          variant: variant,
          name: 'endedTo',
          value: filter.endedTo,
        } only %}
      </div>
    {% endblock %}
  {% endembed %}
</div>
