{% set categoryOptions = categories|map(c => { value: c.name, label: c.name }) %}
{% set brandOptions = brands|map(b => { value: b.name, label: b.name }) %}
{% set priceMax = maxPrice ?? 0 %}

<div {{ attrs(defaults: { class: 'p_products__products-table__filter-panel', popover: true, id: 'products-filter-panel' }, attributes: attributes) }}>
  <form class="filter-form">
    {% include 'components.ui.input.select' with {
      label: 'Category',
      name: 'category',
      value: filter.category,
      placeholder: 'All categories',
      options: categoryOptions,
    } only %}

    {% include 'components.ui.input.select' with {
      label: 'Brand',
      name: 'brand',
      value: filter.brand,
      placeholder: 'All brands',
      options: brandOptions,
    } only %}

    {% include 'components.ui.input.range-slider' with {
      label: 'Price',
      min: 0,
      max: priceMax,
      step: 0.01,
      valueMin: filter.minPrice ?? 0,
      valueMax: filter.maxPrice ?? priceMax,
      nameMin: 'minPrice',
      nameMax: 'maxPrice',
    } only %}

    <label class="field">
      <span class="label">Minimum rating</span>
      <input type="number" name="minRating" min="0" max="5" step="0.1" value="{{ filter.minRating }}">
    </label>

    <div class="actions">
      {% embed 'components.ui.button' with {
        variant: 'neutral',
        attributes: { class: 'filter-clear' },
      } only %}
        {% block label %}Clear filters{% endblock %}
      {% endembed %}
      {% embed 'components.ui.button' with { variant: 'primary', attributes: { type: 'submit' } } only %}
        {% block label %}Apply{% endblock %}
      {% endembed %}
    </div>
  </form>
</div>
