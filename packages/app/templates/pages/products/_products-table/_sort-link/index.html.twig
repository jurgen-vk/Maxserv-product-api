{% set isSorted = filter.sortBy == column %}
{% set nextOrder = (isSorted and filter.order|upper == 'ASC') ? 'DESC' : 'ASC' %}

<th {{ attrs(defaults: { class: 'p_products__products-table__sort-link', 'data-sorted': isSorted ? true : null }, attributes: attributes) }}>
  <a href="#" class="sort-link link" data-column="{{ column }}" data-order="{{ nextOrder }}">
    {{ label }}
    {% if isSorted %}
      {{ icon(filter.order|upper == 'ASC' ? 'lucide:arrow-up' : 'lucide:arrow-down') }}
    {% endif %}
  </a>
</th>
