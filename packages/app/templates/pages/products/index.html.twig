{% extends 'layout/base.html.twig' %}

{% block title %}Products{% endblock %}

{% block content %}
  <div class="flex gap-5 items-start" x-data>

    {# Sidebar filters #}
    <aside class="w-56 shrink-0">
      <div class="bg-white border border-gray-200 rounded-lg p-4 sticky top-6 space-y-4">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Filters</h2>

        <form method="get" action="/products" id="filter-form">
          <input type="hidden" name="sort" value="{{ filter.sortBy }}">
          <input type="hidden" name="order" value="{{ filter.order }}">

          {# Category #}
          {% include 'components/ui/select/select.html.twig' with {
            label:       'Category',
            name:        'category',
            value:       filter.category ?? '',
            placeholder: 'All categories',
            options:     categories|map(c => { value: c.name, label: c.name|capitalize }),
          } %}

          {# Brand #}
          {% include 'components/ui/select/select.html.twig' with {
            label:       'Brand',
            name:        'brand',
            value:       filter.brand ?? '',
            placeholder: 'All brands',
            options:     brands|map(b => { value: b.name, label: b.name }),
          } %}

          {# Price range #}
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Price</label>
            <div class="flex items-center gap-1.5">
              <input type="number" name="minPrice" value="{{ filter.minPrice ?? '' }}" placeholder="Min"
                min="0" step="0.01"
                class="w-full border border-gray-200 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
              <span class="text-gray-300 text-xs shrink-0">–</span>
              <input type="number" name="maxPrice" value="{{ filter.maxPrice ?? '' }}" placeholder="Max"
                min="0" step="0.01"
                class="w-full border border-gray-200 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
            </div>
          </div>

          {# Min rating #}
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Min rating</label>
            <input type="number" name="minRating" value="{{ filter.minRating ?? '' }}" placeholder="0 – 5"
              min="0" max="5" step="0.1"
              class="w-full border border-gray-200 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400">
          </div>

          {# Per page #}
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Per page</label>
            <select name="{{ paginator.countParam }}"
              class="w-full border border-gray-200 rounded px-2 py-1.5 text-sm bg-white focus:outline-none focus:ring-1 focus:ring-gray-400">
              {% for n in [10, 25, 50, 100] %}
                <option value="{{ n }}" {{ n == paginator.perPage ? 'selected' : '' }}>{{ n }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="flex gap-2 pt-1">
            <button type="submit"
              class="flex-1 bg-gray-900 text-white text-sm px-3 py-2 rounded hover:bg-gray-700 transition-colors">
              Apply
            </button>
            <a href="/products"
              class="border border-gray-200 text-sm px-3 py-2 rounded hover:bg-gray-50 transition-colors text-gray-600">
              Reset
            </a>
          </div>
        </form>
      </div>
    </aside>

    {# Main area #}
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-4">
        <input
          type="text"
          name="search"
          form="filter-form"
          value="{{ filter.search ?? '' }}"
          placeholder="Search products…"
          class="flex-1 border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400 bg-white"
        >
        <button type="submit" form="filter-form"
          class="border border-gray-200 bg-white text-sm px-4 py-2 rounded hover:bg-gray-50 transition-colors text-gray-700 whitespace-nowrap">
          Search
        </button>
        <button @click="$store.import.start()" :disabled="$store.import.running"
          class="flex items-center gap-2 bg-gray-900 text-white text-sm px-4 py-2 rounded hover:bg-gray-700 transition-colors disabled:opacity-50 whitespace-nowrap">
          <svg x-show="$store.import.running" x-cloak class="animate-spin w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <span x-text="$store.import.running ? 'Importing…' : 'Import'"></span>
        </button>
      </div>

      <div x-show="$store.import.running" x-cloak class="mb-3">
        <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden">
          <div class="h-full bg-gray-900 transition-all duration-300" :style="`width: ${$store.import.percent}%`"></div>
        </div>
      </div>

      {% include 'components/product/table.html.twig' with {
        items:     items,
        paginator: paginator,
        filter:    filter
      } %}
    </div>

  </div>
{% endblock %}
