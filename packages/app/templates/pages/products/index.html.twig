{% extends 'layouts.main' %}

{% block title %}Products{% endblock %}

{% block content %}
  <div class="p_products">
    {% embed 'components.ui.page-header' with { title: 'Products', icon: icon('lucide:layout-grid') } %}
      {% block actions %}
        {% include 'pages.products._import-button' with { activeImport: activeImport } only %}
      {% endblock %}
    {% endembed %}

    <div class="toolbar">
      {% include 'components.ui.input.search' with {
        value: filter.search,
        placeholder: 'Search products…',
        pageParam: paginator.pageParam,
      } only %}

      {% embed 'components.ui.button' with {
        variant: 'neutral',
        attributes: {
          type: 'button',
          popovertarget: 'products-filter-panel',
          popovertargetaction: 'toggle',
        },
      } %}
        {% block iconBefore %}{{ icon('lucide:list-filter') }}{% endblock %}
        {% block label %}Filters{% endblock %}
      {% endembed %}

      {% include 'pages.products._products-table._filter-panel' with {
        filter: filter,
        categories: categories,
        brands: brands,
        minPrice: minPrice,
        maxPrice: maxPrice,
        pageParam: paginator.pageParam,
      } only %}
    </div>

    {% include 'pages.products._products-table' with { items: items, paginator: paginator, filter: filter, activeImport: activeImport } only %}
  </div>
{% endblock %}
