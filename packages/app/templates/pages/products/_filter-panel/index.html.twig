{% set categoryOptions = categories|map(c => { value: c.name, label: c.name }) %}
{% set brandOptions = brands|map(b => { value: b.name, label: b.name }) %}
{% set priceMax = maxPrice ?? 0 %}

<div {{ attrs(defaults: {
  class: 'p_products__filter-panel'
}, attributes: attributes) }}>
  {% embed 'components.ui.filter-panel' with {
    variant: 'primary',
    id: 'products-filter-panel',
    pageParam: pageParam,
    filter: filter,
    categoryOptions: categoryOptions,
    brandOptions: brandOptions,
    priceMax: priceMax,
  } only %}
    {% block fields %}
      {% include 'components.ui.input.select' with {
        variant: 'primary',
        label: 'Category',
        name: 'category',
        value: filter.category,
        placeholder: 'All categories',
        options: categoryOptions,
        searchable: true,
        settings: {
          allowEmptyOption: false,
          plugins: {
            clear_button
          }
        }
      } only %}

      {% include 'components.ui.input.select' with {
        variant: 'primary',
        label: 'Brand',
        name: 'brand',
        value: filter.brand,
        placeholder: 'All brands',
        options: brandOptions,
        searchable: true,
        settings: {
          allowEmptyOption: false,
          plugins: {
            clear_button
          }
        }
      } only %}

      {% include 'components.ui.input.range-slider' with {
        variant: 'primary',
        label: 'Price',
        min: 0,
        max: priceMax,
        step: 0.01,
        valueMin: filter.minPrice ?? 0,
        valueMax: filter.maxPrice ?? priceMax,
        nameMin: 'minPrice',
        nameMax: 'maxPrice',
      } only %}

      {% include 'components.ui.input.number' with {
        variant: 'primary',
        label: 'Minimum rating',
        name: 'minRating',
        value: filter.minRating,
        min: 0,
        max: 5,
        step: 0.1,
      } only %}
    {% endblock %}
  {% endembed %}
</div>
