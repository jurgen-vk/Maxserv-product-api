{% types {
  categories: 'array<MaxServ\\App\\Entity\\Category>',
  brands: 'array<MaxServ\\App\\Entity\\Brand>',
  maxPrice: 'float|null',
  filter: 'MaxServ\\App\\Filter\\ProductFilter',
  pageParam: 'string',
  variant?: 'string|null',
  attributes?: 'array',
} %}

{% set attributes = attributes|default(null) %}
{% set categoryOptions = categories|map(c => { value: c.name, label: c.name }) %}
{% set brandOptions = brands|map(b => { value: b.name, label: b.name }) %}
{% set priceMax = maxPrice ?? 0 %}
{% set variant = variant|default(null) %}

<div {{ attrs(defaults: {
  class: 'p_products__filter-panel'
}, attributes: attributes) }}>
  {% embed 'components.ui.filter-panel' with {
    variant: variant,
    id: 'products-filter-panel',
    pageParam: pageParam,
    filter: filter,
    categoryOptions: categoryOptions,
    brandOptions: brandOptions,
    priceMax: priceMax,
  } only %}
    {% block fields %}
      {% include 'components.ui.input.select' with {
        variant: variant,
        label: 'Category',
        name: 'category',
        value: filter.category,
        placeholder: 'All categories',
        options: categoryOptions,
        searchable: true,
        settings: {
          allowEmptyOption: false,
          plugins: {
            clear_button: {}
          }
        }
      } only %}

      {% include 'components.ui.input.select' with {
        variant: variant,
        label: 'Brand',
        name: 'brand',
        value: filter.brand,
        placeholder: 'All brands',
        options: brandOptions,
        searchable: true,
        settings: {
          allowEmptyOption: false,
          plugins: {
            clear_button: {}
          }
        }
      } only %}

      {% include 'components.ui.input.range-slider' with {
        variant: variant,
        label: 'Price',
        min: 0,
        max: priceMax,
        step: 0.01,
        valueMin: filter.minPrice ?? 0,
        valueMax: filter.maxPrice ?? priceMax,
        nameMin: 'minPrice',
        nameMax: 'maxPrice',
      } only %}

      {% include 'components.ui.input.number' with {
        variant: variant,
        label: 'Minimum rating',
        name: 'minRating',
        value: filter.minRating,
        min: 0,
        max: 5,
        step: 0.1,
      } only %}
    {% endblock %}
  {% endembed %}
</div>
