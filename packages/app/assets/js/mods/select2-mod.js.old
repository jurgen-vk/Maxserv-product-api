import $ from 'jquery';
// the package's own "main" entry point (dist/js/select2.js) is a slimmed
// build missing the select2/compat/* modules — containerCssClass and
// dropdownCssClass both need select2/compat/containerCss and
// .../dropdownCss respectively, which only exist in the full build, so
// this imports that file directly rather than the bare package specifier.
import select2 from 'select2/dist/js/select2.full.js';

// select2 4.0.13 predates jQuery 4 (this app's version) by years, and
// still calls four static $.* utilities that jQuery 4 removed outright in
// favor of their native equivalents: trim, isArray, isFunction, camelCase
// (jQuery's own final implementations, before removal, were exactly
// this — confirmed against the jQuery changelog, not guessed). This is a
// real incompatibility between the two libraries, not something fixable
// from our own component code, so it's shimmed once here, before select2
// itself runs, rather than patched per call site.
$.trim ??= (str) => (str == null ? '' : `${str}`.trim());
$.isArray ??= Array.isArray;
$.isFunction ??= (obj) => typeof obj === 'function';
$.camelCase ??= (str) => str.replace(/-([a-z])/g, (_, c) => c.toUpperCase());

// select2's UMD wrapper exports a factory function — module.exports =
// function (root, jQuery) { ... } — rather than attaching itself as a
// side effect, so a bare `import 'select2'` never actually runs it and
// $.fn.select2 stays undefined. Calling it explicitly with our own $
// also guarantees it patches the exact same jQuery instance the rest of
// the app uses, rather than risking a second instance via its own
// internal require('jquery') fallback.
select2(window, $);

// Every select2 instance in this app should fill its row unless told
// otherwise — setting the default once here means individual components
// don't repeat `width: '100%'` in every init call. An instance that needs
// something else just passes its own `width` option, which always
// overrides this default (Select2's own options-merging behavior: a
// per-call option beats $.fn.select2.defaults).
$.fn.select2.defaults.set('width', '100%');

// One-time patch, applied once at module load — not per-instance — since
// AttachBody (select2/dropdown/attachBody) is a shared module singleton
// that every select2 instance using dropdownParent-attached rendering
// composes through (the only mode this app uses). Select2's own default
// dropdownAdapter composition (search box, minimumResultsForSearch,
// multiple-vs-single behavior, the dropdownCssClass compat shim, then
// finally AttachBody) only runs when `dropdownAdapter` is left unset in
// the options — supplying a custom one instead would mean reimplementing
// that whole conditional chain by hand just to add one more step at the
// end (see Defaults.prototype.apply in select2.full.js). Wrapping the
// shared method directly — calling the original first, then extending it,
// the same convention Select2's own decorators use on each other (e.g.
// AttachBody.prototype.destroy) — keeps every one of those defaults
// intact automatically, for every consumer of select2 in this app, while
// adding exactly the two behaviors it's missing.
//
// The array-form require(['select2/dropdown/attachBody'], cb) looked right
// but was a real, confirmed bug: select2 bundles almond as its AMD loader,
// and almond's own require() *always* defers the array form through
// setTimeout(fn, 4) — even when the module is already fully defined,
// confirmed by reading almond's source directly (select2.full.js's own
// bundled copy). Every select2 instance on the page gets constructed
// synchronously, as part of the same eager module-import pass that runs
// this file, which all completes well before that 4ms timeout ever fires
// — so every instance's dropdownAdapter was being decorated from the
// *original*, unpatched AttachBody this whole time, patch or no patch
// (confirmed live: calling the decorated instance's own _hideDropdown
// directly had none of the effects patched in below). Almond's own source
// names the fix in its own comment: the *str* form, require('id'),
// resolves synchronously against the same module registry — exactly what's needed here, since
// 'select2/dropdown/attachBody' is already fully defined by the time
// select2(window, $) above returns.
const AttachBody = $.fn.select2.amd.require('select2/dropdown/attachBody');
{
  const original = AttachBody.prototype._positionDropdown;

  AttachBody.prototype._positionDropdown = function () {
    original.call(this);

    // Select2's own _positionDropdown (above) only ever flips vertically
    // (enoughRoomAbove/enoughRoomBelow) — there's no horizontal equivalent
    // at all, confirmed by reading it directly. This mirrors the same
    // idea on the horizontal axis, but as an unconditional rule rather
    // than a reactive overflow correction: a trigger in the right half of
    // the screen always right-aligns its dropdown (grows leftward, flush
    // with the trigger's own right edge); the left half keeps Select2's
    // normal left-aligned default. this.$container is the trigger control;
    // this.$dropdownContainer is the positioned wrapper (what gets its
    // css('left', ...) read/written); this.$dropdown is the real, visible
    // dropdown box — needed here specifically for its width, since
    // $dropdownContainer's own getBoundingClientRect() width is always 0
    // (confirmed live): its only child is position:absolute, which
    // contributes nothing to a parent's own intrinsic sizing, in any
    // layout mode — the same fact that drove animating $dropdown directly
    // rather than its wrapper, back when the opening animation was built.
    const containerRect = this.$container[0].getBoundingClientRect();
    const dropdownRect = this.$dropdown[0].getBoundingClientRect();
    const containerCenter = containerRect.left + containerRect.width / 2;

    if (containerCenter > window.innerWidth / 2) {
      // original.call(this) above already set a correctly offset-parent-
      // adjusted `left` for its own left-aligned positioning (original's
      // own css.left -= parentOffset.left, needed since $dropdownContainer
      // is position:absolute relative to whatever ancestor resolves its
      // containing block — e.g. the [popover] it's nested in for top-layer
      // stacking, not the viewport). A first version of this recomputed an
      // absolute left from raw getBoundingClientRect() values (viewport-
      // relative) without that same adjustment, landing the dropdown
      // wildly off-screen (confirmed live: 3622px right edge against a
      // 1905px viewport) — this only surfaced once the require() timing
      // bug below was fixed and this code actually started running for the
      // first time. Shifting the already-correct value by the width delta
      // instead avoids needing to duplicate that offset math: widths,
      // unlike absolute positions, are identical in both coordinate
      // spaces, so no adjustment is needed for the delta itself.
      const currentLeft = parseFloat(this.$dropdownContainer.css('left'));
      this.$dropdownContainer.css('left', currentLeft + (containerRect.width - dropdownRect.width));
    }

    // When flipped above the trigger, original.call(this) above sets
    // $dropdownContainer's top to (trigger.top - this.$dropdown's height
    // *right now*) — a one-time snapshot, not a live relationship. Any
    // later height change (the whole point of animating it) leaves that
    // top stale, anchored to whatever height happened to exist at this
    // exact call. Undoing that subtraction — adding the exact height
    // that was just subtracted back on — turns $dropdownContainer's own
    // top into the trigger's own top edge, full stop, independent of
    // height. index.css keys off the same select2-dropdown--above class
    // this branch is already scoped to, giving $dropdown itself `bottom:
    // 0` instead of the implicit `top: 0` it has otherwise — with
    // $dropdownContainer's own top now *always* the trigger's edge, that
    // single CSS swap is enough for a plain height animation to grow
    // upward, correctly anchored, with no JS involved in the animation
    // itself: no need to touch $dropdown's own top there at all, in
    // either direction, exactly as below already didn't.
    if (this.$dropdown.hasClass('select2-dropdown--above')) {
      const currentTop = parseFloat(this.$dropdownContainer.css('top'));
      this.$dropdownContainer.css('top', currentTop + this.$dropdown.outerHeight(false));
    }
  };

  // Select2 detaches the dropdown the instant it closes — _hideDropdown is
  // exactly, only, `this.$dropdownContainer.detach();` — leaving no time
  // for a reverse animation to play. Tried intercepting the cancelable
  // select2:closing event to defer that instead, but that also blocks
  // Select2's own "is this open" bookkeeping for as long as the fake close
  // is pending — isOpen() and select2-container--open are toggled by a
  // *separate* listener (Select2.prototype._registerEvents, confirmed by
  // reading the source), so preventing 'close' from ever firing left
  // Select2 believing it was still open, meaning every click during the
  // pending animation called close() again instead of open(). Patching
  // _hideDropdown directly sidesteps that: this is the ONE place that
  // actually removes the element from the DOM, so deferring just that
  // leaves every other part of Select2's state completely normal,
  // regardless of animation timing.
  //
  // CSS @keyframes were tried first and have a real, unfixable-in-CSS
  // problem for this specific case: a keyframe animation always starts
  // from its own hardcoded 0% value when newly applied — it can't
  // continue from wherever a *different*, currently-running animation
  // actually is. Confirmed live: clicking to close while the opening
  // animation was still mid-flight snapped the box to full height first
  // (the closing keyframes' own hardcoded 0%), then visibly shrank from
  // there, instead of continuing smoothly from its actual current height.
  // The Web Animations API below fixes this at the root — every call
  // reads the element's real current height via getBoundingClientRect()
  // and animates from exactly there, and Animation#finished is a real
  // Promise (resolves on completion, rejects on cancel()), so reopening
  // mid-close can cleanly cancel and take over with no fixed keyframe
  // involved at any point.
  const originalHide = AttachBody.prototype._hideDropdown;
  const originalShow = AttachBody.prototype._showDropdown;
  const originalBind = AttachBody.prototype.bind;

  // duration/easing are the only two options given a project default;
  // every other Web Animations option (delay, iterations, ...) is left to
  // the browser's own default unless a caller explicitly overrides it —
  // the options object below is spread directly into animate(), so
  // nothing here is hardcoded as "the only tunable thing". --shoot
  // (cubic-bezier(0.25, 1.15, 0.3, 1), base.css) has control points above
  // y=1, i.e. it overshoots past its target before settling back — a good
  // fit for something growing into place, but wrong for something
  // shrinking to nothing: confirmed live, applying it to the close
  // direction made height dip to ~0 early (the overshoot briefly
  // interpolates past the 0px end value, which the browser clamps),
  // then visibly climb back up slightly before actually finishing. Plain
  // 'ease' for close avoids that overshoot entirely.
  $.fn.select2.defaults.set('animateDropdown', {
    open: {duration: 200, easing: '--shoot'},
    close: {duration: 200, easing: '--shoot'}
  });

  // animate()'s easing needs a literal str, not a var() reference —
  // this resolves either a literal ('ease', 'cubic-bezier(...)') or a bare
  // custom-property name ('--shoot') against :root, so callers can reuse
  // the same design tokens used everywhere else in the app instead of
  // duplicating a cubic-bezier literal in every override.
  function resolveEasing(value) {
    return value.startsWith('--')
      ? getComputedStyle(document.documentElement).getPropertyValue(value).trim()
      : value;
  }

  // Temporarily releases any inline height this element is currently
  // holding (from a finished animation's hand-back) to read its true
  // natural height for whatever content it holds right now — needed
  // both for the AJAX case (content can change after this element
  // already exists) and for the plain "how tall should this grow to"
  // question on a fresh open.
  //
  // Also re-runs _positionDropdown (the patched version, so the
  // horizontal-flip fix applies too) while height is at that natural
  // value, rather than trusting Select2's own results:all-triggered call
  // to _positionDropdown (via _bindContainerResultHandlers) to have
  // already used the right height: that listener is bound lazily, on the
  // first open, while this one is bound once in bind(), at construction
  // — earlier — so per normal first-registered-first-called event
  // ordering, this handler actually runs *before* Select2's own, not
  // after. Repositioning explicitly here, using this element's real
  // current (unconstrained) height, makes the result correct regardless
  // of that ordering rather than relying on it.
  function measureNaturalHeightAndReposition(instance) {
    const el = instance.$dropdown[0];
    const prevHeight = el.style.height;
    // padding/border are pinned alongside height now (see _showDropdown and
    // animateDropdownSize) — clearing only height here would measure a
    // height that's missing whatever padding is currently pinned to,
    // understating the real natural height by however much of it is
    // pinned away at the moment this runs
    const prevPaddingTop = el.style.paddingTop;
    const prevPaddingBottom = el.style.paddingBottom;
    const prevBorderTopWidth = el.style.borderTopWidth;
    const prevBorderBottomWidth = el.style.borderBottomWidth;

    el.style.height = 'auto';
    el.style.paddingTop = '';
    el.style.paddingBottom = '';
    el.style.borderTopWidth = '';
    el.style.borderBottomWidth = '';

    const height = el.getBoundingClientRect().height;
    instance._positionDropdown();

    el.style.height = prevHeight;
    el.style.paddingTop = prevPaddingTop;
    el.style.paddingBottom = prevPaddingBottom;
    el.style.borderTopWidth = prevBorderTopWidth;
    el.style.borderBottomWidth = prevBorderBottomWidth;

    return height;
  }

  // Animates this dropdown's height to targetHeight (0 to close, or its
  // natural full height to open/resize) — the same, single height
  // animation regardless of direction: which edge stays fixed while it
  // grows/shrinks is handled entirely by index.css (plain top:0 below,
  // bottom:0 for select2-dropdown--above) plus _positionDropdown's own
  // fix above keeping $dropdownContainer's top pinned to the trigger's
  // edge no matter what height was current when it last ran. No JS
  // positioning math needed here at all, in either direction.
  //
  // A plain function taking the instance explicitly, not an
  // AttachBody.prototype method — Select2's own Utils.Decorate wraps
  // *every* method it finds on AttachBody.prototype (getMethods
  // enumerates them all, including ones added after the fact by this
  // patch), unshifting a decorated/original-method placeholder as the
  // first argument before calling through — harmless for _hideDropdown/
  // _showDropdown above since neither takes real parameters, but
  // confirmed live to silently break this one: targetHeight arrived as
  // that placeholder function instead of the real number, since the
  // decorator shifted it into an undeclared second argument. Not being a
  // decorated method at all sidesteps that entirely.
  // padding/border are fixed by index.css and never change per-instance — measured
  // once and cached from then on. _showDropdown now pins padding/border to 0
  // before this ever runs for a fresh open (matching what it already did for
  // height), so — unlike the very first version of this function — this can no
  // longer assume computed style is untouched on that first call; it has to
  // clear any pinned inline override first, the same "temporarily release, read,
  // restore" trick measureNaturalHeightAndReposition already uses for height.
  function naturalBoxEdges(instance, el) {
    if (!instance._naturalBoxEdges) {
      const prevPaddingTop = el.style.paddingTop;
      const prevPaddingBottom = el.style.paddingBottom;
      const prevBorderTopWidth = el.style.borderTopWidth;
      const prevBorderBottomWidth = el.style.borderBottomWidth;

      el.style.paddingTop = '';
      el.style.paddingBottom = '';
      el.style.borderTopWidth = '';
      el.style.borderBottomWidth = '';

      const cs = getComputedStyle(el);
      instance._naturalBoxEdges = {
        paddingTop: parseFloat(cs.paddingTop),
        paddingBottom: parseFloat(cs.paddingBottom),
        borderTopWidth: parseFloat(cs.borderTopWidth),
        borderBottomWidth: parseFloat(cs.borderBottomWidth)
      };

      el.style.paddingTop = prevPaddingTop;
      el.style.paddingBottom = prevPaddingBottom;
      el.style.borderTopWidth = prevBorderTopWidth;
      el.style.borderBottomWidth = prevBorderBottomWidth;
    }
    return instance._naturalBoxEdges;
  }

  // Animating height alone hits a hard floor: even with box-sizing: border-box,
  // the height property only controls the content area — padding and border are
  // fixed, non-negotiable sizes that height can't compress below. Confirmed live:
  // closing (0.5rem padding + 1px border = 18px total) shrank smoothly down to
  // exactly 18px, sat there rendering no visible change for the remainder of the
  // 200ms duration (the animation was still running the whole time — the *target*
  // height genuinely reached 0 — none of it below the 18px floor could ever paint),
  // then vanished outright once _hideDropdown's originalHide call detached the
  // element the instant the animation finished. Animating padding/border to 0 in
  // lockstep with height removes that floor entirely — real 0 by the time the
  // animation completes, on both edges, closing or opening.
  function animateDropdownSize(instance, targetHeight) {
    const el = instance.$dropdown[0];
    if (!el || !el.isConnected) {
      return null;
    }

    const natural = naturalBoxEdges(instance, el);
    const cs = getComputedStyle(el);
    const startHeight = el.getBoundingClientRect().height;
    const startPaddingTop = parseFloat(cs.paddingTop);
    const startPaddingBottom = parseFloat(cs.paddingBottom);
    const startBorderTopWidth = parseFloat(cs.borderTopWidth);
    const startBorderBottomWidth = parseFloat(cs.borderBottomWidth);

    if (instance._sizeAnimation) {
      instance._sizeAnimation.cancel();
    }

    const directionKey = targetHeight === 0 ? 'close' : 'open';
    const {duration, easing, ...rest} = instance.options.get('animateDropdown')[directionKey];

    const target = targetHeight === 0
      ? {paddingTop: 0, paddingBottom: 0, borderTopWidth: 0, borderBottomWidth: 0}
      : natural;

    instance._sizeAnimation = el.animate(
      [
        {
          height: `${startHeight}px`,
          paddingTop: `${startPaddingTop}px`,
          paddingBottom: `${startPaddingBottom}px`,
          borderTopWidth: `${startBorderTopWidth}px`,
          borderBottomWidth: `${startBorderBottomWidth}px`
        },
        {
          height: `${targetHeight}px`,
          paddingTop: `${target.paddingTop}px`,
          paddingBottom: `${target.paddingBottom}px`,
          borderTopWidth: `${target.borderTopWidth}px`,
          borderBottomWidth: `${target.borderBottomWidth}px`
        }
      ],
      {...rest, duration, easing: resolveEasing(easing), fill: 'forwards'}
    );

    return instance._sizeAnimation;
  }

  AttachBody.prototype._showDropdown = function () {
    const el = this.$dropdown[0];
    // captured *before* cancel() below reverts it to its underlying,
    // unconstrained style — 0 for a genuinely fresh open (disconnected
    // elements report an all-zero rect), or the real current value if
    // this interrupts a still-running close.
    const currentHeight = el.getBoundingClientRect().height;

    // padding/border can't reuse that same rect trick: getComputedStyle keeps
    // resolving a fixed-unit declaration like padding: 0.5rem even on a
    // disconnected element, since that only needs the cascade plus root
    // font-size, not real layout — confirmed live, it read back the full 8px/
    // 1px natural values here, not 0, unlike the rect above. The only case
    // that actually needs a *live* read is interrupting a still-running
    // close, where the current value is genuinely mid-interpolation; a fresh
    // open has no animation to interrupt, so it's explicitly zeroed instead
    // of trusting a read that — for this specific pair of properties, for
    // this specific reason — doesn't naturally come back as 0 the way
    // height's does.
    const wasAnimating = !!this._sizeAnimation;
    let currentPaddingTop = 0;
    let currentPaddingBottom = 0;
    let currentBorderTopWidth = 0;
    let currentBorderBottomWidth = 0;
    if (wasAnimating) {
      const currentCs = getComputedStyle(el);
      currentPaddingTop = parseFloat(currentCs.paddingTop);
      currentPaddingBottom = parseFloat(currentCs.paddingBottom);
      currentBorderTopWidth = parseFloat(currentCs.borderTopWidth);
      currentBorderBottomWidth = parseFloat(currentCs.borderBottomWidth);
    }

    // cancels a running close so it can never finish and detach the
    // element out from under a reopen — matters most once results can
    // arrive asynchronously (AJAX): the gap between this and the next
    // results:all could be arbitrarily long, long enough for a stale
    // close to complete on its own otherwise.
    if (this._sizeAnimation) {
      this._sizeAnimation.cancel();
    }

    // pins the element at exactly the height (and padding/border — see
    // animateDropdownSize's own comment for why those need to move
    // together with height) just captured, immediately — without this,
    // nothing constrains height at all between now and the eventual
    // results:all-triggered grow (see bind() below), so the element would
    // render at its natural full size the instant originalShow attaches
    // it below, confirmed live: by the time results:all's handler ran,
    // this was already the *full* height, making its own start and end
    // keyframes identical (no visible animation at all, despite no error
    // — the animation genuinely had nothing to interpolate). Pinning here
    // keeps it visually collapsed (or wherever an interrupted close left
    // it) through that whole gap.
    el.style.height = `${currentHeight}px`;
    el.style.paddingTop = `${currentPaddingTop}px`;
    el.style.paddingBottom = `${currentPaddingBottom}px`;
    el.style.borderTopWidth = `${currentBorderTopWidth}px`;
    el.style.borderBottomWidth = `${currentBorderBottomWidth}px`;

    originalShow.call(this); // real attach + position + resize, unanimated

    // results aren't rendered into the DOM yet at this exact point —
    // Select2's own query handler fires 'open' (which runs this whole
    // method, synchronously, including originalShow above) *before* it
    // queries data and renders results, confirmed live: measuring
    // height here counted only 1 result element, not the real list,
    // giving a too-short animation target. The actual grow animation is
    // triggered from results:all instead (see bind() below) — that
    // fires once results genuinely exist, whether the query behind it
    // resolved synchronously (this app's current local option data) or
    // asynchronously (a future AJAX-backed data source, entirely out of
    // this method's control) — a fixed delay or microtask would only
    // ever cover the synchronous case.
  };

  AttachBody.prototype._hideDropdown = function () {
    const animation = animateDropdownSize(this, 0);
    if (!animation) {
      originalHide.call(this);
      return;
    }

    const self = this;
    animation.finished
      // only actually detach once the shrink genuinely finishes
      .then(() => {
        originalHide.call(self);
      })
      // interrupted by a reopen — _showDropdown above already canceled
      // this and a fresh results:all-triggered grow takes over
      .catch(() => {
      });
  };

  AttachBody.prototype.bind = function (decorated, container, $container) {
    originalBind.call(this, decorated, container, $container);

    const self = this;
    // fires once results genuinely exist in the DOM — after the very
    // first query (open), after every subsequent one (live search
    // filtering), and, once this app has an AJAX-backed data source,
    // after that request actually resolves. Growing/resizing from here
    // instead of from open() is what makes this correct regardless of
    // how long that takes. results:message covers the empty "no results
    // found" state the same way, so the box still resizes to fit it
    // instead of jumping.
    //
    // Select2's own event system (Observable.prototype.on, confirmed by
    // reading it directly) takes a single literal event name per call —
    // no jQuery-style space-separated shorthand — so results:all and
    // results:message each need their own .on() call, not one call with
    // a combined str (confirmed live: that registered a listener
    // under the literal, never-triggered key "results:all
    // results:message", silently never firing at all).
    //
    // A microtask defer here is still necessary, separately from the
    // AJAX question: Observable's trigger() calls every listener bound
    // to an event synchronously, in registration order — this one is
    // bound once in bind(), at construction, which turned out to run
    // *before* whatever listener actually renders results into the DOM
    // (bound later, confirmed live: measuring immediately here counted
    // only the "Searching…" placeholder, 1 element, while a plain
    // rAF-timed poll outside this dispatch already saw the real 4
    // options from its very first frame). A microtask runs after the
    // *entire* synchronous results:all dispatch finishes — including
    // that render listener, wherever it falls in the order — which
    // holds regardless of whether the query behind this event resolved
    // synchronously or over the network: by the time results:all fires
    // at all, any waiting on the network is already done, and every
    // listener for it runs synchronously from that point on.
    function onResultsChanged() {
      Promise.resolve().then(() => {
        const el = self.$dropdown[0];
        if (!el || !el.isConnected) {
          return;
        }
        animateDropdownSize(self, measureNaturalHeightAndReposition(self));
      });
    }

    container.on('results:all', onResultsChanged);
    container.on('results:message', onResultsChanged);
  };
}
