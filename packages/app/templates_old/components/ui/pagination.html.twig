{#
  Variables expected:
    paginator   — Paginator DTO
    extraParams — array of additional query params to preserve (e.g. { category: 'phones', sort: 'price' })
    baseUrl     — string (e.g. '/products')
#}
{% set extraParams = extraParams ?? {} %}

<div class="flex items-center justify-between mt-4 text-sm text-gray-500">
  <span>
    {% if paginator.total > 0 %}
      Showing {{ paginator.offset + 1 }}–{{ min(paginator.offset + paginator.perPage, paginator.total) }}
      of {{ paginator.total }}
    {% else %}
      No results
    {% endif %}
  </span>

  {% if paginator.totalPages > 1 %}
    <div class="flex items-center gap-1">

      {# Build base query string from extraParams #}
      {% set qs = '' %}
      {% for k, v in extraParams %}
        {% if v is not empty or v == 0 %}
          {% set qs = qs ~ '&' ~ k ~ '=' ~ v|url_encode %}
        {% endif %}
      {% endfor %}
      {% set qs = qs ~ '&' ~ paginator.perPageParam ~ '=' ~ paginator.perPage %}

      {% if paginator.hasPreviousPage %}
        <a href="{{ baseUrl }}?{{ paginator.pageParam }}={{ paginator.page - 1 }}{{ qs }}"
           class="px-3 py-1.5 rounded border border-gray-200 bg-white hover:bg-gray-50 transition-colors">
          &larr; Prev
        </a>
      {% else %}
        <span class="px-3 py-1.5 rounded border border-gray-100 text-gray-300 cursor-not-allowed">&larr; Prev</span>
      {% endif %}

      {% set start = max(1, paginator.page - 2) %}
      {% set end   = min(paginator.totalPages, paginator.page + 2) %}

      {% if start > 1 %}
        <a href="{{ baseUrl }}?{{ paginator.pageParam }}=1{{ qs }}"
           class="px-2.5 py-1.5 rounded border border-gray-200 bg-white hover:bg-gray-50 transition-colors">1</a>
        {% if start > 2 %}<span class="px-1 text-gray-300">…</span>{% endif %}
      {% endif %}

      {% for p in start..end %}
        <a href="{{ baseUrl }}?{{ paginator.pageParam }}={{ p }}{{ qs }}"
           class="px-2.5 py-1.5 rounded border transition-colors {{ p == paginator.page ? 'bg-gray-900 text-white border-gray-900 font-medium' : 'border-gray-200 bg-white hover:bg-gray-50' }}">
          {{ p }}
        </a>
      {% endfor %}

      {% if end < paginator.totalPages %}
        {% if end < paginator.totalPages - 1 %}<span class="px-1 text-gray-300">…</span>{% endif %}
        <a href="{{ baseUrl }}?{{ paginator.pageParam }}={{ paginator.totalPages }}{{ qs }}"
           class="px-2.5 py-1.5 rounded border border-gray-200 bg-white hover:bg-gray-50 transition-colors">
          {{ paginator.totalPages }}
        </a>
      {% endif %}

      {% if paginator.hasNextPage %}
        <a href="{{ baseUrl }}?{{ paginator.pageParam }}={{ paginator.page + 1 }}{{ qs }}"
           class="px-3 py-1.5 rounded border border-gray-200 bg-white hover:bg-gray-50 transition-colors">
          Next &rarr;
        </a>
      {% else %}
        <span class="px-3 py-1.5 rounded border border-gray-100 text-gray-300 cursor-not-allowed">Next &rarr;</span>
      {% endif %}

    </div>
  {% endif %}
</div>
