{#
Variables expected:
  label       — str
  name        — str (form field name)
  value       — str (currently selected value)
  placeholder — str (shown when nothing selected, e.g. 'All categories')
  options     — array of { value: str, label: str }
#}
<div x-data="selectSearch({{ { value: value, options: options }|json_encode }})" @click.outside="open = false">
  <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">{{ label }}</label>
  <div class="relative">
    <button type="button" @click="open = !open"
            class="w-full flex items-center justify-between gap-2 border border-gray-200 rounded px-3 py-1.5 text-sm bg-white text-left">
      <span class="truncate text-gray-700" x-text="selectedLabel ?? {{ placeholder|json_encode }}"></span>
      <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>

    <div x-show="open" x-cloak
         class="absolute z-20 top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg">
      <div class="p-2 border-b border-gray-100">
        <input type="text" x-model="query"
               class="w-full border border-gray-200 rounded px-2 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-gray-300"
               placeholder="Search…">
      </div>
      <ul class="max-h-52 overflow-y-auto py-1">
        <li @click="select('')"
            class="px-3 py-1.5 text-sm cursor-pointer hover:bg-gray-50 text-gray-500"
            :class="!value ? 'bg-gray-50 font-medium' : ''">
          {{ placeholder }}
        </li>
        <template x-for="option in filteredOptions" :key="option.value">
          <li @click="select(option.value)"
              class="px-3 py-1.5 text-sm cursor-pointer hover:bg-gray-50"
              :class="value === option.value ? 'bg-gray-50 font-medium text-gray-900' : 'text-gray-700'"
              x-text="option.label">
          </li>
        </template>
      </ul>
    </div>

    <input type="hidden" name="{{ name }}" :value="value">
  </div>
</div>
