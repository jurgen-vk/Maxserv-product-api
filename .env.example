# Controls both the detail shown on error pages (full exception + stack trace vs a generic
# message) and PHP's own display_errors setting. Must be false for any real deployment.
APP_DEBUG=true

# Controls cache-freshness behavior everywhere (container/Twig/route caches, OPcache) — independent
# of APP_DEBUG, which controls only error verbosity. Anything other than the literal "prod" is
# treated as dev (fail-closed: a typo here should never silently serve a stale cache).
APP_ENV=dev

# The app's own public URL, as the browser sees it — used to tell Mercure which origin is
# allowed to subscribe to its SSE streams (cors_origins). Change this to the real https://
# domain in production; nothing else needs to change alongside it.
APP_URL=http://localhost:8080

# Where the Vite dev server runs during local development (`npm --workspace=packages/app run
# dev`, on the host, not in Docker). Only used when APP_ENV is dev; ignored in production, where
# assets are pre-built and served from the manifest instead. No trailing slash — ViteManifest
# concatenates this directly with a leading-slash basePath ('/assets/'), so a trailing slash
# here would produce a double slash and 404.
VITE_SERVER_URL=http://localhost:5173

MYSQL_ROOT_PASSWORD=placeholder_root_password
MYSQL_DATABASE=placeholder_db_name
MYSQL_USER=placeholder_user
MYSQL_PASSWORD=placeholder_password

MERCURE_PUBLISHER_JWT_KEY=placeholder_mercure_key
MERCURE_SUBSCRIBER_JWT_KEY=placeholder_mercure_key
MERCURE_PUBLISHER_JWT=placeholder_pre_generated_jwt
MERCURE_HUB_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
MERCURE_SERVER_NAME=:80
MERCURE_PORT=3000

# TODO (production): Mercure currently runs on its own host port (MERCURE_PORT), with no
# reverse proxy in front of it - deliberately deferred, not decided yet. Two real options
# when this gets picked up later:
#   (a) keep Mercure on its own port/subdomain, no proxy needed - just point
#       MERCURE_PUBLIC_URL at wherever it ends up being hosted; or
#   (b) add a second Apache vhost that reverse-proxies to the Mercure container over the
#       Docker network. Note: as of this writing, mod_proxy/mod_proxy_http are NOT
#       enabled anywhere in the Dockerfile (only `a2enmod rewrite` runs today), and there
#       is no existing custom vhost file in this repo to extend - only the base
#       php:8.5-apache image's default vhost, patched in place by docker-entrypoint.sh's
#       `sed` calls. Both would need to be added from scratch if (b) is chosen.
# Do not implement either option without discussing it first.