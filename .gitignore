# Ignore everything by default
*

# Project files
!/.gitignore
!/README.md
!/public
!/public/index.php
!/public/.htaccess

# Composer
!/composer.json
!/composer.lock

# npm
!/package-lock.json

# Docker
!/Dockerfile
!/docker-compose.yml
!/.dockerignore
!/Caddyfile
!/Caddyfile.dev

# Configuration
!.env.example

# Packages
!/packages
!/packages/core
!/packages/core/**/*
!/packages/app
!/packages/app/**/*

# Generated at build time by packages/app/vite-plugins/css-component-glob.js
/packages/app/assets/css/_components.generated.css

# Vite's own dependency pre-bundling cache, wherever it lands
/packages/*/node_modules

# CLI scripts
!/bin
!/bin/console

# Node manifest
!/package.json
